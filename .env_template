# .env_template – скопируй в .env и заполни своими данными

# API для курсов валют (рекомендую https://currencyapi.com)
# Получить ключ: зарегистрироваться на сайте, в личном кабинете взять API-ключ
CURRENCY_API_KEY=your_currency_api_key_here
CURRENCY_API_URL=https://api.currencyapi.com/v3/latest

# API для цен акций (рекомендую https://www.alphavantage.co)
# Получить ключ: бесплатная регистрация на alphavantage.co
STOCK_API_KEY=your_stock_api_key_here
STOCK_API_URL=https://www.alphavantage.co/query

# (Опционально) базовые валюты для расчётов – можно переопределить
BASE_CURRENCY=RUB
